# IBM Artifactory Registry Configuration
# Replace <YOUR_API_KEY> with your actual Artifactory API key
# Scoped packages from IBM Artifactory
@ais:registry=https://na.artifactory.swg-devops.com/artifactory/api/npm/sec-common-npm-local/
# Authentication (uncomment and add your credentials)
# //na.artifactory.swg-devops.com/artifactory/api/npm/sec-common-npm-local/:_auth=<YOUR_BASE64_ENCODED_CREDENTIALS>
# OR use API key:
# //na.artifactory.swg-devops.com/artifactory/api/npm/sec-common-npm-local/:_authToken=<YOUR_API_KEY>
# Default registry for other packages
registry=https://registry.npmjs.org/