# Application Settings
APP_NAME="NGFW PQC Detector"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_LOG_LEVEL="INFO"
APP_WORKERS=4

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC_TLS_LOGS="suricata-events"
KAFKA_CONSUMER_GROUP="ngfw-pqc-detector"
KAFKA_AUTO_OFFSET_RESET="latest"

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE="ngfw_pqc"
MONGODB_COLLECTION="tls_connections"
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# TLS/PQC Detection Settings
PQC_DETECTION_ENABLED=True
CLASSICAL_CRYPTO_DETECTION_ENABLED=True
HYBRID_CRYPTO_DETECTION_ENABLED=True

# Suricata Integration
SURICATA_LOG_PATH="/var/log/suricata/eve.json"
SURICATA_ENABLED=True

# API Settings
API_ENABLE_CORS=True
API_CORS_ORIGINS=["http://localhost:8081"]

# Analytics Settings
ANALYTICS_ENABLED=True
ANALYTICS_BATCH_INTERVAL=60
ANALYTICS_TIME_WINDOW=60

# Monitoring & Metrics
METRICS_ENABLED=True
METRICS_PORT=9090
